# PermitZero — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Startup validation prints the NAMES of missing variables only, never values.

# --- Runtime ---------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# Port for the API service (Fastify).
PORT=8080
# Public base URL of the API, used by the web dashboard.
API_BASE_URL=http://127.0.0.1:8080
# Comma-separated allowed browser origins. No wildcards.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# How long SIGTERM lets in-flight requests finish before connections are closed
# forcibly. Keep this BELOW the orchestrator's stop grace period: Fastify drains
# correctly but does not resolve close() until the idle keep-alive sockets expire,
# which measured 70 seconds. Without a bound here the container is SIGKILLed
# mid-shutdown and the database pools are torn down without their close().
SHUTDOWN_GRACE_MS=10000

# Bearer token for GET /metrics. Left empty, the endpoint is not registered at
# all — there is no route to probe and no default to forget to change.
# Prometheus scrapes it over the private compose network with
# `authorization: { credentials_file: ... }`; see infra/observability/prometheus.
METRICS_TOKEN=

# --- Data stores (PostgreSQL is the system of record) ----------------------
# Local native PostgreSQL 17. This is the MIGRATION/admin role: it owns the
# schema and is exempt from row-level security, so it must not serve tenant
# traffic.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/permitzero
# The restricted runtime role created by infra/migrations/0006. Every tenant read
# and write goes through this connection, which is what makes the database — not
# the query — responsible for tenant isolation. If you set this to the admin URL
# above, /health/ready and boot both report tenant isolation as NOT enforced.
DATABASE_URL_RUNTIME=postgres://pz_app:pz_app_dev@127.0.0.1:5432/permitzero
# Password used when 0006 creates/alters pz_app. Development only; a real
# deployment sets its own and rotates it. Restricted to [A-Za-z0-9_.-] because it
# is substituted into SQL text.
PZ_RLS_ROLE_PASSWORD=pz_app_dev
# Pool ceiling for the runtime role. Each tenant-scoped transaction holds one
# connection for its lifetime, so this bounds concurrent tenant work.
RUNTIME_POOL_MAX=10
# Separate database for integration tests — never point tests at the demo DB.
# The test harness derives the pz_app URL from this one automatically.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/permitzero_test
REDIS_URL=redis://127.0.0.1:6379

# --- Security --------------------------------------------------------------
# Identifier (not the key material) of the key used for audit hash chaining.
AUDIT_HASH_KEY_ID=audit-hmac-key-v1
# The audit HMAC key itself. Keep out of source control.
#
# REQUIRED whenever APP_ENV is anything other than development or test. Without
# it the audit chain is a plain unkeyed SHA-256 instead of a keyed HMAC, and
# the tamper-evidence property this product exists to provide is quietly gone —
# anybody with database access can recompute the hash of a row they changed.
# Outside development and test the API and the worker fail to boot naming this
# variable rather than falling back to the unkeyed hash.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY=
# Signing key id for execution permits.
PERMIT_SIGNING_KEY_ID=permit-signing-key-v1
PERMIT_SIGNING_KEY=

# --- Permit and request limits ----------------------------------------------
# Permit lifetime. PRD FR-031: default short, no refresh without re-evaluation.
PERMIT_TTL_SECONDS=60
# Maximum request body size in bytes (413 above this). PRD §8.5.
MAX_BODY_BYTES=262144

# --- Meta Model API (advisory only — never an authorization authority) -----
# MODEL_PROVIDER: disabled | static | meta. `static` is a deterministic test
# double; `meta` calls the live API. MODEL_ENABLED=false forces deterministic
# offline operation regardless of provider. The demo and every acceptance gate
# must pass with the model disabled (Master Prompt §1).
MODEL_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# Verify the exact model ID against the current project dashboard before use.
# Do not invent or assume model availability (PRD FR-072).
MODEL_ID=
MODEL_TIMEOUT_MS=30000
MODEL_MAX_ATTEMPTS=5
MODEL_MAX_CONCURRENCY=4
MODEL_RETRY_BASE_MS=250
MODEL_RETRY_CAP_MS=8000
MODEL_PROMPT_VERSION=risk-hints-prompt-v1
MODEL_SCHEMA_VERSION=risk-hints.v1
# Breaker: open after this many consecutive transport failures, retry after cooldown.
MODEL_BREAKER_THRESHOLD=5
MODEL_BREAKER_COOLDOWN_MS=30000

# --- Queue / workers -------------------------------------------------------
# The knobs the worker actually reads; these are the names in
# apps/worker/src/config.ts. The queue package itself reads no environment at
# all, so a tuning knob that is not listed here is a no-op wherever it is set.
#
# Milliseconds between outbox claim batches.
DISPATCH_POLL_MS=500
# Rows claimed per dispatcher batch.
DISPATCH_BATCH_SIZE=50
# Milliseconds between reconciliation sweep passes.
SWEEP_INTERVAL_MS=30000
# Rows settled per sweep pass.
SWEEP_BATCH_SIZE=100
# Deliveries per job before the job is dead-lettered.
JOB_ATTEMPTS=5
# Consumer concurrency per queue.
WORKER_CONCURRENCY=4
# Age before an unknown execution is reconciled (in-flight calls settle first).
RECONCILE_GRACE_MS=30000

# --- Rate limiting ---------------------------------------------------------
# The global ceiling, then the two tighter budgets applied on top of it.
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=60000
# State-changing calls (intake, approvals, permit collection).
RATE_LIMIT_MUTATIONS_PER_MIN=120
# Credential-bearing requests — the brute-force surface.
RATE_LIMIT_AUTH_PER_MIN=20

# Proxy hops whose X-Forwarded-For may be believed, comma separated. Leave it at
# the loopback default when Caddy is the only hop: with trustProxy disabled every
# request presents the proxy's address and the rate limiter shares one bucket
# across all tenants, so one busy caller can lock everyone out.
TRUSTED_PROXIES=127.0.0.1,::1
