# PermitZero deployment environment — TEMPLATE.
#
# The real file is `infra/deploy/permitzero.env`, generated on the host by
# deploy-vps.sh, mode 0600, and gitignored. Never commit a filled-in copy.
#
# Two audiences read this file: docker compose uses the PZ_* names for
# interpolation (ports, hostname, tunnel token), and the containers receive the
# whole file through `env_file`, so the runtime names below are what the
# services actually see.

# --- compose interpolation -------------------------------------------------
# Space-separated. Every name gets a SAN on the same certificate and its own
# entry in the shared front door's maps. The Cloudflare-proxied one is the only
# hostname whose requests have actually passed WAF and the rate-limit rules.
PZ_HOSTNAMES=permitzero.example
PZ_ACME_EMAIL=ops@example.com
PZ_HTTP_PORT=8050
PZ_HTTPS_PORT=8450
PZ_SEED=0
# Leave empty unless the `tunnel` profile is enabled; cloudflared refuses an
# empty token loudly rather than silently running a dead connector.
PZ_TUNNEL_TOKEN=

PZ_PG_USER=permitzero
PZ_PG_PASSWORD=replace-me
PZ_PG_DB=permitzero

# --- runtime ---------------------------------------------------------------
# `staging`, not `production`: the seed refuses to write synthetic demo data
# when APP_ENV=production, and the connector refuses fault injection there too.
# Every record this deployment holds is synthetic and the console says so.
APP_ENV=staging
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# How long SIGTERM lets in-flight requests finish before connections are closed
# forcibly. Keep this BELOW the orchestrator's stop grace period: Fastify drains
# correctly but does not resolve close() until the idle keep-alive sockets expire,
# which measured 70 seconds. Without a bound here the container is SIGKILLed
# mid-shutdown and the database pools are torn down without their close().
SHUTDOWN_GRACE_MS=10000

# Admin/migration role — owns the schema and is exempt from row-level security.
DATABASE_URL=postgres://PZ_PG_USER:PZ_PG_PASSWORD@postgres:5432/PZ_PG_DB
# Restricted runtime role, created by infra/migrations/0006_row_level_security.sql.
# Every tenant read and write goes through this connection. Leaving it unset makes
# the app fall back to the admin role and report tenant isolation as NOT enforced
# on /health/ready, in the boot log and on /v1/status — the fallback is loud.
DATABASE_URL_RUNTIME=postgres://pz_app:PZ_RLS_ROLE_PASSWORD@postgres:5432/PZ_PG_DB
# Password 0006 assigns pz_app. Rotate it with `ALTER ROLE pz_app PASSWORD ...`
# and re-set here; it is substituted into SQL text, so keep it to [A-Za-z0-9_.-].
PZ_RLS_ROLE_PASSWORD=
# One pooled connection per in-flight tenant transaction; bounds concurrent
# tenant work against Postgres max_connections.
RUNTIME_POOL_MAX=10
REDIS_URL=redis://redis:6379

# --- metrics ---------------------------------------------------------------
# Bearer token for GET /metrics on the API. Empty means the endpoint is not
# registered at all. Prometheus scrapes it by service name on the compose
# network (infra/observability/prometheus/prometheus.yml reads this value from a
# mounted file); Caddy refuses the path on the public hostname.
METRICS_TOKEN=

# --- signing / hashing keys (generate: openssl rand -hex 32) ---------------
PERMIT_SIGNING_KEY=
PERMIT_SIGNING_KEY_ID=permit-key-v1
# The audit HMAC key. REQUIRED here: this deployment runs with APP_ENV=staging,
# and the API and the worker refuse to boot without it. An unkeyed audit chain
# would still verify, so the failure would not announce itself — it would just
# quietly stop being tamper-evident.
AUDIT_HMAC_KEY=
AUDIT_HASH_KEY_ID=audit-hmac-key-v1

# --- enforcement posture ---------------------------------------------------
PERMIT_TTL_SECONDS=60
MAX_BODY_BYTES=262144
# Browser origins allowed to call this API. Empty means no cross-origin caller
# at all, which is the correct default: the console reaches the API same-origin
# through the edge rewrite.
CORS_ORIGINS=
# The global rate-limit ceiling, then the two tighter budgets on top of it.
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=60000
# State-changing calls (intake, approvals, permit collection).
RATE_LIMIT_MUTATIONS_PER_MIN=120
# Credential-bearing requests — the brute-force surface.
RATE_LIMIT_AUTH_PER_MIN=20

# --- queue / worker --------------------------------------------------------
# The knobs the worker reads; see apps/worker/src/config.ts. The queue package
# reads no environment of its own, so a knob that is not listed here does
# nothing wherever it is set.
#
# Milliseconds between outbox claim batches.
DISPATCH_POLL_MS=500
# Rows claimed per dispatcher batch.
DISPATCH_BATCH_SIZE=50
# Milliseconds between reconciliation sweep passes.
SWEEP_INTERVAL_MS=30000
# Rows settled per sweep pass.
SWEEP_BATCH_SIZE=100
# Deliveries per job before the job is dead-lettered.
JOB_ATTEMPTS=5
# Consumer concurrency per queue.
WORKER_CONCURRENCY=5
# Age before an unknown execution is reconciled (in-flight calls settle first).
RECONCILE_GRACE_MS=30000

# --- Meta Model API (advisory only, never an authorization authority) -------
# The demo must pass with the model disabled; enabling it adds risk hints and
# explanations, not permissions.
MODEL_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=
MODEL_TIMEOUT_MS=30000
MODEL_MAX_ATTEMPTS=5
MODEL_MAX_CONCURRENCY=4
MODEL_RETRY_BASE_MS=250
MODEL_RETRY_CAP_MS=8000
MODEL_PROMPT_VERSION=risk-hints-prompt-v1
MODEL_SCHEMA_VERSION=risk-hints.v1
# Breaker: open after this many consecutive transport failures, retry after cooldown.
MODEL_BREAKER_THRESHOLD=5
MODEL_BREAKER_COOLDOWN_MS=30000

# The compose edge is the only hop, and it is on this container network.
TRUSTED_PROXIES=127.0.0.1,::1
