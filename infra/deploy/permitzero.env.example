# PermitZero deployment environment — TEMPLATE.
#
# The real file is `infra/deploy/permitzero.env`, generated on the host by
# deploy-vps.sh, mode 0600, and gitignored. Never commit a filled-in copy.
#
# Two audiences read this file: docker compose uses the PZ_* names for
# interpolation (ports, hostname, tunnel token), and the containers receive the
# whole file through `env_file`, so the runtime names below are what the
# services actually see.

# --- compose interpolation -------------------------------------------------
# Space-separated. Every name gets a SAN on the same certificate and its own
# entry in the shared front door's maps. The Cloudflare-proxied one is the only
# hostname whose requests have actually passed WAF and the rate-limit rules.
PZ_HOSTNAMES=permitzero.example
PZ_ACME_EMAIL=ops@example.com
PZ_HTTP_PORT=8050
PZ_HTTPS_PORT=8450
PZ_SEED=0
# Leave empty unless the `tunnel` profile is enabled; cloudflared refuses an
# empty token loudly rather than silently running a dead connector.
PZ_TUNNEL_TOKEN=

PZ_PG_USER=permitzero
PZ_PG_PASSWORD=replace-me
PZ_PG_DB=permitzero

# --- runtime ---------------------------------------------------------------
# `staging`, not `production`: the seed refuses to write synthetic demo data
# when APP_ENV=production, and the connector refuses fault injection there too.
# Every record this deployment holds is synthetic and the console says so.
APP_ENV=staging
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://PZ_PG_USER:PZ_PG_PASSWORD@postgres:5432/PZ_PG_DB
REDIS_URL=redis://redis:6379

# --- signing / hashing keys (generate: openssl rand -hex 32) ---------------
PERMIT_SIGNING_KEY=
PERMIT_SIGNING_KEY_ID=permit-key-v1
AUDIT_HMAC_KEY=
AUDIT_HASH_KEY_ID=audit-hmac-key-v1

# --- enforcement posture ---------------------------------------------------
PERMIT_TTL_SECONDS=60
MAX_BODY_BYTES=262144
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=60000

# --- Meta Model API (advisory only, never an authorization authority) -------
# The demo must pass with the model disabled; enabling it adds risk hints and
# explanations, not permissions.
MODEL_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_ID=
MODEL_TIMEOUT_MS=30000
MODEL_MAX_ATTEMPTS=5
MODEL_MAX_CONCURRENCY=4
MODEL_PROMPT_VERSION=risk-hints-prompt-v1
MODEL_SCHEMA_VERSION=risk-hints.v1
