{
  "name": "@permitzero/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed",
    "db:reset": "tsx src/cli.ts reset",
    "db:health": "tsx src/cli.ts health",
    "db:generate": "echo migrations are handwritten SQL under infra/migrations"
  },
  "dependencies": {
    "@permitzero/broker": "*",
    "@permitzero/domain": "*",
    "@permitzero/schemas": "*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
