{
  "name": "@permitzero/provider-meta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "model:check": "tsx src/check.ts"
  },
  "dependencies": {
    "@permitzero/domain": "*",
    "@permitzero/schemas": "*",
    "zod": "^3.24.1"
  }
}
