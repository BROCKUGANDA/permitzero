    "@permitzero/policy": "*",
    "@permitzero/provider-meta": "*",
    "@permitzero/queue": "*",
    "@permitzero/schemas": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "tsx": "^4.19.2",
    "zod": "^4.6.7",
    "@permitzero/observability": "*"
